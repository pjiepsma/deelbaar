{
  "name": "deelbaar-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "android": "pnpm --filter @deelbaar/core android",
    "ios": "pnpm --filter @deelbaar/core ios",
    "start": "pnpm --filter @deelbaar/core start",
    "dev": "pnpm copy:payload-types && concurrently -n \"CMS,CORE\" -c \"bgBlue.bold,bgMagenta.bold\" \"pnpm dev:cms\" \"pnpm dev:core\"",
    "dev:core": "pnpm --filter @deelbaar/core dev",
    "dev:cms": "pnpm --filter @deelbaar/cms dev",
    "prebuild": "pnpm --filter @deelbaar/core prebuild",
    "eas": "pnpm --filter @deelbaar/core eas",
    "kill:dev-ports": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/kill-dev-ports.ps1",
    "seed:listings": "pnpm --filter @deelbaar/cms seed:listings",
    "copy:payload-types": "node scripts/sync-payload-types.cjs",
    "lint": "pnpm --filter @deelbaar/core lint",
    "format": "pnpm --filter @deelbaar/core format"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "heroui-pro",
      "heroui-native-pro"
    ],
    "overrides": {
      "react-native-worklets": "~0.8.0"
    }
  },
  "version": "1.0.0"
}