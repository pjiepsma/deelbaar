# Hoisted layout shortens paths under node_modules/.pnpm/... which avoids Windows
# CMAKE_OBJECT_PATH_MAX (~250) failures when building react-native-worklets / NDK.
# After changing node-linker: rm node_modules, pnpm install, then delete android/build
# and android/.gradle (stale autolinking.json keeps old .pnpm paths and breaks Gradle).
node-linker=hoisted
