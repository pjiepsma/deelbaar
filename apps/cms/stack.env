# Stack Environment Variables
# Note: Sensitive values (like PAYLOAD_SECRET) should be overridden in Portainer's Environment Variables section
# This file is for non-sensitive defaults

SELECTED_CONFIG=production
MONGODB_URI=mongodb://mongo:27017/payload
BACKEND_URL=http://localhost:4000
FRONTEND_URL=http://localhost:4000
EXPO_URLS=
SENTRY_ORG=deelbaar
SENTRY_PROJECT=deelbaar-payload

# Sensitive values - MUST be set in Portainer Environment Variables section:
# PAYLOAD_SECRET=
# SENTRY_DSN=
# NEXT_PUBLIC_SENTRY_DSN=
# RESEND_API_KEY=
