# Postgres connection (PostGIS-enabled instance recommended).
DATABASE_URI=postgresql://postgres:postgres@127.0.0.1:5432/payload

# Must match apps/cms/src/config/config.ts (env name is SELECTED_CONFIG, not SELECT_CONFIG).
SELECTED_CONFIG=default

# If port 4000 is already in use (e.g. another CMS dev), override before `pnpm dev` / `pnpm dev:cms`:
#   PowerShell: $env:PORT='4001'; pnpm dev:cms
#   bash:       PORT=4001 pnpm dev:cms
# PORT=4001

PAYLOAD_SECRET=YOUR_SECRET_HERE
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com,your-google-ios-client-id.apps.googleusercontent.com

# Firebase Cloud Messaging (CMS sends push via firebase-admin; not Expo Push)
# 1. Firebase Console → Project Settings → Service accounts → Generate new private key
# 2. Save JSON locally (never commit): apps/cms/.secrets/firebase-service-account.json
# 3. Rotate key if it was ever exposed in chat/logs/git
FIREBASE_SERVICE_ACCOUNT_PATH=./.secrets/firebase-service-account.json
FIREBASE_PROJECT_ID=deelbaar

# Optional: scheme segment for mobile verification deep links in emails (default: deelbaar).
# MOBILE_AUTH_CALLBACK_SCHEME=deelbaar
