DATABASE_URI=mongodb://127.0.0.1/your-database-name

# If port 4000 is already in use (e.g. another CMS dev), override before `pnpm dev` / `pnpm dev:cms`:
#   PowerShell: $env:PORT='4001'; pnpm dev:cms
#   bash:       PORT=4001 pnpm dev:cms
# PORT=4001

# Optional: persist Mongo Memory Server under apps/cms (default is a fresh temp dir each run).
# MONGO_MEMORY_PERSIST_PATH=bin/storage
PAYLOAD_SECRET=YOUR_SECRET_HERE
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
