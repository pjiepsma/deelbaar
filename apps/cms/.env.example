# Mongo connection (QD-P style: prefer MONGODB_URI; DATABASE_URL or legacy DATABASE_URI also work).
MONGODB_URI=mongodb://127.0.0.1:27017/payload

# Must match apps/cms/src/config/config.ts (env name is SELECTED_CONFIG, not SELECT_CONFIG).
SELECTED_CONFIG=default

# If port 4000 is already in use (e.g. another CMS dev), override before `pnpm dev` / `pnpm dev:cms`:
#   PowerShell: $env:PORT='4001'; pnpm dev:cms
#   bash:       PORT=4001 pnpm dev:cms
# PORT=4001

# Dev Mongo data: memDb defaults to apps/cms/bin/storage (next to bin/memDb.js).
# Override path (relative to CMS package cwd), or force a fresh DB each run:
# MONGO_MEMORY_PERSIST_PATH=bin/storage
# MONGO_MEMORY_EPHEMERAL=true

# Wipe persisted data on next start (any mode with a fixed path):
# CLEAN_DB=true

PAYLOAD_SECRET=YOUR_SECRET_HERE
GOOGLE_CLIENT_IDS=your-web-client-id.apps.googleusercontent.com,your-ios-client-id.apps.googleusercontent.com
