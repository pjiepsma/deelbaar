{
  "name": "@deelbaar/mobile",
  "version": "0.0.1",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "lint": "eslint \"**/*.{js,jsx,ts,tsx}\" && prettier -c \"**/*.{js,jsx,ts,tsx,json}\"",
    "format": "eslint \"**/*.{js,jsx,ts,tsx}\" --fix && prettier \"**/*.{js,jsx,ts,tsx,json}\" --write",
    "ios": "expo run:ios",
    "start": "node ../../scripts/sync-payload-types.cjs && expo start",
    "prebuild": "expo prebuild --platform android --clean",
    "dev": "expo start --dev-client",
    "eas": "eas build --platform android --local",
    "copy:payload-types": "node ../../scripts/sync-payload-types.cjs"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.5.2",
    "@react-native-ml-kit/text-recognition": "^2.0.0",
    "@rnmapbox/maps": "^10.2.7",
    "@tamagui/animations-react-native": "2.0.0-rc.36",
    "@tamagui/config": "2.0.0-rc.36",
    "@tamagui/core": "2.0.0-rc.36",
    "@tamagui/portal": "2.0.0-rc.36",
    "@tamagui/sheet": "2.0.0-rc.36",
    "@tanstack/react-query": "^5.90.7",
    "expo": "~55.0.12",
    "expo-constants": "~55.0.12",
    "expo-dev-client": "~55.0.23",
    "expo-file-system": "^55.0.15",
    "expo-font": "~55.0.6",
    "expo-image-manipulator": "^55.0.14",
    "expo-image-picker": "~55.0.17",
    "expo-linear-gradient": "~55.0.12",
    "expo-linking": "~55.0.11",
    "expo-location": "~55.1.7",
    "expo-notifications": "~55.0.17",
    "expo-router": "~55.0.11",
    "expo-sqlite": "~55.0.14",
    "expo-status-bar": "~55.0.5",
    "expo-system-ui": "~55.0.14",
    "fastest-levenshtein": "^1.0.16",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.1",
    "react-native-nitro-modules": "^0.31.9",
    "react-native-reanimated": "~4.2.1",
    "react-native-reanimated-carousel": "^4.0.3",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0",
    "react-native-worklets": "0.7.2",
    "tamagui": "2.0.0-rc.36"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-async-generator-functions": "^7.25.0",
    "@tamagui/babel-plugin": "2.0.0-rc.36",
    "@types/base-64": "^1",
    "@types/lodash": "^4.17.7",
    "@types/react": "~19.2.14",
    "@types/react-dom": "~19.1.7",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "depcheck": "^1.4.7",
    "eslint": "8.57.0",
    "eslint-config-universe": "14.0.0",
    "prettier": "^3.2.5",
    "typescript": "~5.9.2"
  },
  "eslintConfig": {
    "extends": "universe/native"
  },
  "expo": {
    "install": {
      "exclude": []
    },
    "doctor": {
      "reactNativeDirectoryCheck": {
        "listUnknownPackages": false
      }
    }
  }
}
